server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_set_header Origin "";
    }

    location /v1/ {
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header Origin "";
    }

    location /oauth2/ {
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header Origin "";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
